{
  "name": "coin-quest-arena",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "server",
    "client"
  ],
  "scripts": {
    "build": "npm run build -w @arena/shared && npm run build -w @arena/bot-contract && npm run build -w @arena/bot-navigation && npm run build -w @arena/client && npm run build -w @arena/server",
    "dev": "npm run dev -w @arena/client",
    "present": "npm run dev -w @arena/server",
    "reset-bot": "node scripts/reset-bot.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "bot:trace": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/bot-trace.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
